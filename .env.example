# Environment Variables Template for HendyAppStore Server Ecosystem

# Telegram Bot Worker
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=HendyAppStoreBot
TELEGRAM_WEBHOOK_SECRET=hex_secret_key_for_telegram_webhook
TELEGRAM_ADMIN_IDS=123456789,987654321

# Cloudflare D1 Database
D1_DATABASE_NAME=hendy_appstore_db
D1_DATABASE_ID=d1-prod-hendy-001

# Cloudflare KV Namespaces
KV_FEATURE_FLAGS_ID=kv-ff-001
KV_BOT_CONFIG_ID=kv-bot-001
KV_MAINTENANCE_ID=kv-maint-001

# Cloudflare Queues
QUEUE_BANK_SYNC_NAME=bank-sync-queue
QUEUE_BROADCAST_NAME=telegram-broadcast-queue
QUEUE_OTA_BUILD_NAME=ota-build-queue
QUEUE_DLQ_NAME=dead-letter-queue

# Platform API Security
API_JWT_SECRET=super_secret_jwt_hmac_sha256_key
API_ADMIN_KEY=admin_secret_super_api_key_header
ENCRYPTION_KEY=32_byte_aes_gcm_secret_key_base64

# Bank Webhook Gateway
BANK_WEBHOOK_SECRET=bank_gateway_signature_secret_v1
BANK_WEBHOOK_IP_WHITELIST=103.111.222.0/24,103.111.223.0/24

# External Services
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
AXIOM_TOKEN=xapt-dummy-token-for-cloudflare
AXIOM_DATASET=hendy-logs

# App Releases & OTA
OTA_STORAGE_R2_BUCKET=hendy-app-releases
OTA_CDN_DOMAIN=https://cdn.hendyappstore.com
